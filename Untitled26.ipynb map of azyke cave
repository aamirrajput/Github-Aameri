        "import matplotlib.pyplot as plt\n",
        "import cartopy.crs as ccrs\n",
        "import cartopy.feature as cfeature\n",
        "from matplotlib.patches import FancyArrowPatch\n",
        "\n",
        "# Key locations (lon, lat)\n",
        "locations = {\n",
        "    \"Africa\": (20, 0),\n",
        "    \"Split near Black Sea\": (35, 42),\n",
        "    \"South Asia\": (75, 25),\n",
        "    \"Southeast Asia\": (110, 10),\n",
        "    \"Australia\": (135, -25),\n",
        "    \"South Caucasus\": (43, 41)\n",
        "}\n",
        "\n",
        "# Time labels\n",
        "levels = {\n",
        "    \"Africa\": \"100-200 kya\",\n",
        "    \"Split near Black Sea\": \"50 kya\",\n",
        "    \"South Asia\": \"50-40 kya\",\n",
        "    \"Southeast Asia\": \"45-40 kya\",\n",
        "    \"Australia\": \"40-35 kya\",\n",
        "    \"South Caucasus\": \"45-40 kya\"\n",
        "}\n",
        "\n",
        "# Initialize map\n",
        "fig = plt.figure(figsize=(15,10))\n",
        "ax = plt.axes(projection=ccrs.PlateCarree())\n",
        "ax.set_extent([-20, 160, -40, 60])\n",
        "ax.add_feature(cfeature.LAND, facecolor='lightgray')\n",
        "ax.add_feature(cfeature.OCEAN, facecolor='lightblue')\n",
        "ax.add_feature(cfeature.BORDERS, linestyle=':')\n",
        "ax.coastlines()\n",
        "\n",
        "# Function to draw curved arrows\n",
        "def draw_arrow(start, end, color='blue', rad=0.2):\n",
        "    arrow = FancyArrowPatch(start, end, connectionstyle=f\"arc3,rad={rad}\",\n",
        "                            color=color, arrowstyle='-|>', mutation_scale=15, lw=2)\n",
        "    ax.add_patch(arrow)\n",
        "\n",
        "# Plot locations and labels\n",
        "for name, (lon, lat) in locations.items():\n",
        "    ax.plot(lon, lat, 'o', color='red', markersize=6, transform=ccrs.PlateCarree())\n",
        "    ax.text(lon+1, lat+1, f\"{name}\\n{levels[name]}\", fontsize=9, transform=ccrs.PlateCarree())\n",
        "\n",
        "# Draw migration routes\n",
        "draw_arrow(locations[\"Africa\"], locations[\"Split near Black Sea\"], rad=0.2)\n",
        "draw_arrow(locations[\"Split near Black Sea\"], locations[\"South Asia\"], rad=-0.2)\n",
        "draw_arrow(locations[\"South Asia\"], locations[\"Southeast Asia\"], rad=-0.1)\n",
        "draw_arrow(locations[\"Southeast Asia\"], locations[\"Australia\"], rad=-0.2)\n",
        "draw_arrow(locations[\"Split near Black Sea\"], locations[\"South Caucasus\"], rad=0.1)\n",
        "\n",
        "# Title\n",
        "plt.title(\"Human Migration Routes: Out-of-Africa, Southern Route, and South Caucasus Settlement\", fontsize=14)\n",
        "plt.show()\n"
      ],
