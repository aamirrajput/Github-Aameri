        "import matplotlib.pyplot as plt\n",
        "import cartopy.crs as ccrs\n",
        "import cartopy.feature as cfeature\n",
        "from cartopy.io import shapereader\n",
        "import matplotlib.patheffects as pe\n",
        "\n",
        "# Map extent for Southern Caucasus\n",
        "minx, maxx, miny, maxy = 38, 55, 36, 45\n",
        "\n",
        "# Figure\n",
        "plt.figure(figsize=(9, 7), dpi=200)\n",
        "ax = plt.axes(projection=ccrs.PlateCarree())\n",
        "ax.set_extent([minx, maxx, miny, maxy], crs=ccrs.PlateCarree())\n",
        "ax.set_facecolor(\"#eef5fb\")\n",
        "\n",
        "# Base features\n",
        "ax.add_feature(cfeature.LAND.with_scale('50m'), facecolor=\"#e6e6e6\", edgecolor=\"black\", linewidth=0.4)\n",
        "ax.add_feature(cfeature.OCEAN.with_scale('50m'), facecolor=\"#eef5fb\")\n",
        "ax.add_feature(cfeature.BORDERS.with_scale('50m'), linewidth=0.6)\n",
        "\n",
        "# Load Natural Earth countries and highlight the targets\n",
        "shp = shapereader.natural_earth(resolution='50m', category='cultural', name='admin_0_countries')\n",
        "records = shapereader.Reader(shp).records()\n",
        "\n",
        "target = {\"Armenia\", \"Azerbaijan\", \"Georgia\"}\n",
        "neighbors = {\"Iran\", \"Turkey\", \"Russia\"}\n",
        "\n",
        "for rec in records:\n",
        "    name = rec.attributes.get(\"NAME_LONG\") or rec.attributes.get(\"ADMIN\") or rec.attributes.get(\"NAME\")\n",
        "    geom = rec.geometry\n",
        "    if name in target:\n",
        "        ax.add_geometries([geom], ccrs.PlateCarree(), facecolor=\"#bcd9bb\", edgecolor=\"black\", linewidth=1.0, alpha=0.95, hatch=\"////\")\n",
        "    elif name in neighbors:\n",
        "        ax.add_geometries([geom], ccrs.PlateCarree(), facecolor=\"#d0dce7\", edgecolor=\"black\", linewidth=0.6, alpha=0.95)\n",
        "\n",
        "# Azykh Cave (approx.)\n",
        "azyx_lon, azyx_lat = 47.165, 39.652\n",
        "ax.plot(azyx_lon, azyx_lat, marker=\"o\", markersize=6, color=\"red\", markeredgecolor=\"black\", transform=ccrs.PlateCarree(), zorder=5)\n",
        "ax.text(azyx_lon+0.3, azyx_lat+0.1, \"Azykh Cave\", transform=ccrs.PlateCarree(),\n",
        "        fontsize=10, weight=\"bold\", path_effects=[pe.withStroke(linewidth=2.5, foreground=\"white\")], zorder=6)\n",
        "\n",
        "# Gridlines + labels\n",
        "gl = ax.gridlines(draw_labels=True, linestyle=\":\", linewidth=0.5)\n",
        "gl.top_labels = False\n",
        "gl.right_labels = False\n",
        "\n",
        "# Simple scale bar (~300 km at 40°N; 1° lon ≈ 85.4 km)\n",
        "x0, y0 = 39.5, 36.5\n",
        "km = 300\n",
        "deg = km / 85.4\n",
        "ax.plot([x0, x0+deg], [y0, y0], transform=ccrs.PlateCarree(), color=\"black\", linewidth=3)\n",
        "ax.text(x0+deg/2, y0-0.2, f\"{km} km\", transform=ccrs.PlateCarree(), ha=\"center\", va=\"top\", fontsize=9)\n",
        "\n",
        "plt.title(\"Southern Caucasus Study Area by Countries\\n(Armenia, Azerbaijan, Georgia highlighted)\", pad=12)\n",
        "plt.tight_layout()\n",
        "plt.savefig(\"southern_caucasus_map.png\", dpi=300)\n",
        "plt.savefig(\"southern_caucasus_map.svg\")\n",
        "plt.show()"
