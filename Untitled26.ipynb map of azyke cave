        "import matplotlib.pyplot as plt\n",
        "import matplotlib.patheffects as pe\n",
        "import cartopy.crs as ccrs\n",
        "import cartopy.feature as cfeature\n",
        "from cartopy.io import shapereader\n",
        "from matplotlib.offsetbox import AnchoredText\n",
        "\n",
        "# Map extent\n",
        "EXTENT = [38, 55, 36, 45]  # [min_lon, max_lon, min_lat, max_lat]\n",
        "\n",
        "# Figure\n",
        "plt.figure(figsize=(10, 8), dpi=200)\n",
        "ax = plt.axes(projection=ccrs.PlateCarree())\n",
        "ax.set_extent(EXTENT, crs=ccrs.PlateCarree())\n",
        "ax.set_facecolor(\"#eef5fb\")\n",
        "\n",
        "# Base layers\n",
        "ax.add_feature(cfeature.LAND.with_scale('50m'), facecolor=\"#e6e6e6\", edgecolor=\"black\", linewidth=0.4, zorder=0)\n",
        "ax.add_feature(cfeature.OCEAN.with_scale('50m'), facecolor=\"#eef5fb\", zorder=0)\n",
        "ax.add_feature(cfeature.COASTLINE.with_scale('50m'), linewidth=0.4, zorder=1)\n",
        "ax.add_feature(cfeature.BORDERS.with_scale('50m'), linewidth=0.6, zorder=2)\n",
        "ax.add_feature(cfeature.LAKES.with_scale('50m'), edgecolor=\"black\", facecolor=\"#eef5fb\", linewidth=0.3, zorder=1)\n",
        "\n",
        "# Countries (targets vs neighbors)\n",
        "targets = {\"Armenia\", \"Azerbaijan\", \"Georgia\"}\n",
        "neighbors = {\"Iran\", \"Turkey\", \"Russia\"}\n",
        "\n",
        "shp = shapereader.natural_earth(resolution='50m', category='cultural', name='admin_0_countries')\n",
        "for rec in shapereader.Reader(shp).records():\n",
        "    name = rec.attributes.get(\"NAME_LONG\") or rec.attributes.get(\"ADMIN\") or rec.attributes.get(\"NAME\")\n",
        "    geom = rec.geometry\n",
        "    if name in targets:\n",
        "        ax.add_geometries([geom], ccrs.PlateCarree(), facecolor=\"#bcd9bb\", edgecolor=\"black\",\n",
        "                          linewidth=1.0, alpha=0.95, hatch=\"////\", zorder=2)\n",
        "    elif name in neighbors:\n",
        "        ax.add_geometries([geom], ccrs.PlateCarree(), facecolor=\"#d0dce7\", edgecolor=\"black\",\n",
