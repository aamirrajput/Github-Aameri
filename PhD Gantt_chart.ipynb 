    {
      "cell_type": "code",
      "source": [
        "\n",
        "import pandas as pd\n",
        "import matplotlib.pyplot as plt\n",
        "import matplotlib.dates as mdates\n",
        "from matplotlib.gridspec import GridSpec\n",
        "\n",
        "# ============================================================\n",
        "# 1. COURSE DATA\n",
        "# ============================================================\n",
        "\n",
        "data = [\n",
        "    # Scientific courses – 10 ECTS\n",
        "    (\"Scientific courses\", \"Geochronology\",\n",
        "     \"2026-01-19\", \"2026-06-15\", 5),\n",
        "    (\"Scientific courses\", \"Sedimentary Archives – theoretical part\",\n",
        "     \"2026-01-19\", \"2026-06-15\", 5),\n",
        "\n",
        "    # GSNS onboarding – 4 ECTS\n",
        "    (\"GSNS onboarding programme\", \"Introduction Day – GSNS\",\n",
        "     \"2025-06-18\", \"2025-06-18\", None),\n",
        "    (\"GSNS onboarding programme\", \"Research Integrity\",\n",
        "     \"2025-09-23\", \"2025-09-23\", None),\n",
        "    (\"GSNS onboarding programme\", \"PhD Career Perspective\",\n",
        "     \"2025-10-22\", \"2025-10-22\", None),\n",
        "    (\"GSNS onboarding programme\", \"Becoming a Scientist\",\n",
        "     \"2025-11-12\", \"2025-11-12\", None),\n",
        "    (\"GSNS onboarding programme\", \"Well-being and Work–Life Balance\",\n",
        "     \"2025-11-25\", \"2025-11-25\", None),\n",
        "    (\"GSNS onboarding programme\", \"Efficient Writing for PhD Students\",\n",
        "     \"2025-11-28\", \"2025-11-28\", None),\n",
        "    (\"GSNS onboarding programme\",\n",
        "     \"Literature, Data Management and Publication\",\n",
        "     \"2025-12-11\", \"2025-12-11\", None),\n",
        "\n",
        "    # Transferable skills – 7.5 ECTS\n",
        "    (\"Transferable skills\", \"Introduction to R Programming\",\n",
        "     \"2026-02-24\", \"2026-02-25\", 1),\n",
        "    (\"Transferable skills\", \"Science Teaching\",\n",
        "     \"2026-02-25\", \"2026-06-11\", 2.5),\n",
        "    (\"Transferable skills\", \"Basic Academic and Professional English\",\n",
        "     \"2026-04-13\", \"2026-05-04\", 2.5),\n",
        "    (\"Transferable skills\", \"AI for Scientific Writing\",\n",
        "     \"2026-04-23\", \"2026-04-30\", 1.5),\n",
        "\n",
        "    # Academic development – 9 ECTS\n",
        "    (\"Academic development / alternative ECTS\",\n",
        "     \"ITEASc Science Communication Workshop\",\n",
        "     \"2025-08-18\", \"2025-08-20\", 1),\n",
        "    (\"Academic development / alternative ECTS\",\n",
        "     \"Urbino Summer School in Paleoclimatology\",\n",
        "     \"2026-07-21\", \"2026-08-06\", 6),\n",
        "    (\"Academic development / alternative ECTS\",\n",
        "     \"Azykh Cave fieldwork, Azerbaijan\",\n",
        "     \"2026-08-25\", \"2026-08-30\", 2),\n",
        "]\n",
        "\n",
        "df = pd.DataFrame(\n",
        "    data,\n",
        "    columns=[\"Category\", \"Course\", \"Start\", \"End\", \"ECTS\"]\n",
        ")\n",
        "\n",
        "df[\"Start\"] = pd.to_datetime(df[\"Start\"])\n",
        "df[\"End\"] = pd.to_datetime(df[\"End\"])\n",
        "\n",
        "# ============================================================\n",
        "# 2. CATEGORIES AND COLOURS\n",
        "# ============================================================\n",
        "\n",
        "categories = [\n",
        "    \"Scientific courses\",\n",
        "    \"GSNS onboarding programme\",\n",
        "    \"Transferable skills\",\n",
        "    \"Academic development / alternative ECTS\"\n",
        "]\n",
        "\n",
        "colours = {\n",
        "    \"Scientific courses\": \"#356AC3\",\n",
        "    \"GSNS onboarding programme\": \"#269B85\",\n",
        "    \"Transferable skills\": \"#D99832\",\n",
        "    \"Academic development / alternative ECTS\": \"#9068BC\"\n",
        "}\n",
        "\n",
        "totals = {\n",
        "    \"Scientific courses\": 10,\n",
        "    \"GSNS onboarding programme\": 4,\n",
        "    \"Transferable skills\": 7.5,\n",
        "    \"Academic development / alternative ECTS\": 9\n",
        "}\n",
        "\n",
        "# ============================================================\n",
        "# 3. LARGE FONT SETTINGS\n",
        "# ============================================================\n",
        "\n",
        "TITLE_FONT = 42\n",
        "CATEGORY_FONT = 30\n",
        "COURSE_FONT = 28\n",
        "AXIS_FONT = 25\n",
        "TABLE_FONT = 27\n",
        "\n",
        "plt.rcParams.update({\n",
        "    \"font.family\": \"DejaVu Sans\",\n",
        "    \"font.size\": 25,\n",
        "    \"pdf.fonttype\": 42\n",
        "})\n",
        "\n",
        "# ============================================================\n",
        "# 4. CREATE FIGURE\n",
        "# ============================================================\n",
        "\n",
        "fig = plt.figure(figsize=(35, 31), facecolor=\"white\")\n",
        "\n",
        "gs = GridSpec(\n",
        "    2, 1,\n",
        "    figure=fig,\n",
        "    height_ratios=[7, 1.4],\n",
        "    hspace=0.25\n",
        ")\n",
        "\n",
        "ax = fig.add_subplot(gs[0])\n",
        "ax_table = fig.add_subplot(gs[1])\n",
        "\n",
        "# ============================================================\n",
        "# 5. ROW POSITIONS\n",
        "# ============================================================\n",
        "\n",
        "rows = []\n",
        "y = 0\n",
        "\n",
        "for category in categories:\n",
        "\n",
        "    rows.append((\"heading\", category, None, y))\n",
        "    y += 2.1\n",
        "\n",
        "    subset = df[df[\"Category\"] == category].sort_values(\"Start\")\n",
        "\n",
        "    for _, course in subset.iterrows():\n",
        "        rows.append((\"course\", category, course, y))\n",
        "        y += 1.9\n",
        "\n",
        "    y += 1.0\n",
        "\n",
        "# ============================================================\n",
        "# 6. TIMELINE\n",
        "# ============================================================\n",
        "\n",
        "xmin = pd.Timestamp(\"2025-05-01\")\n",
        "xmax = pd.Timestamp(\"2026-10-01\")\n",
        "\n",
        "ax.set_xlim(xmin, xmax)\n",
        "ax.set_ylim(y + 0.5, -1)\n",
        "\n",
        "ax.xaxis.set_major_locator(\n",
        "    mdates.MonthLocator(interval=2)\n",
        ")\n",
        "\n",
        "ax.xaxis.set_major_formatter(\n",
        "    mdates.DateFormatter(\"%b %Y\")\n",
        ")\n",
        "\n",
        "ax.xaxis.set_minor_locator(\n",
        "    mdates.MonthLocator()\n",
        ")\n",
        "\n",
        "ax.grid(\n",
        "    axis=\"x\",\n",
        "    which=\"major\",\n",
        "    color=\"#D5DDE8\",\n",
        "    linestyle=\"--\",\n",
        "    linewidth=1.2\n",
        ")\n",
        "\n",
        "ax.grid(\n",
        "    axis=\"x\",\n",
        "    which=\"minor\",\n",
        "    color=\"#EEF1F5\",\n",
        "    linewidth=0.7\n",
        ")\n",
        "\n",
        "ax.set_axisbelow(True)\n",
        "\n",
        "# ============================================================\n",
        "# 7. DRAW GANTT CHART\n",
        "# ============================================================\n",
        "\n",
        "tick_positions = []\n",
        "tick_labels = []\n",
        "\n",
        "course_counter = 0\n",
        "\n",
        "for kind, category, course, ypos in rows:\n",
        "\n",
        "    if kind == \"heading\":\n",
        "\n",
        "        ax.axhspan(\n",
        "            ypos - 0.7,\n",
        "            ypos + 0.7,\n",
        "            color=colours[category],\n",
        "            alpha=0.12\n",
        "        )\n",
        "\n",
        "        ax.text(\n",
        "            mdates.date2num(xmin) + 5,\n",
        "            ypos,\n",
        "            f\"{category} | {totals[category]:g} ECTS\",\n",
        "            fontsize=CATEGORY_FONT,\n",
        "            fontweight=\"bold\",\n",
        "            color=colours[category],\n",
        "            va=\"center\"\n",
        "        )\n",
        "        continue\n",
        "\n",
        "    course_counter += 1\n",
        "\n",
        "    start = mdates.date2num(course[\"Start\"])\n",
        "    end = mdates.date2num(course[\"End\"])\n",
        "    duration = end - start + 1\n",
        "\n",
        "    colour = colours[category]\n",
        "\n",
        "    if course_counter % 2 == 0:\n",
        "        ax.axhspan(\n",
        "            ypos - 0.8,\n",
        "            ypos + 0.8,\n",
        "            color=\"#F5F7FA\",\n",
        "            zorder=0\n",
        "        )\n",
        "\n",
        "    if duration <= 2:\n",
        "        ax.scatter(\n",
        "            start,\n",
        "            ypos,\n",
        "            marker=\"D\",\n",
        "            s=400,\n",
        "            color=colour,\n",
        "            edgecolors=\"white\",\n",
        "            linewidth=1.5,\n",
        "            zorder=5\n",
        "        )\n",
        "    else:\n",
        "        ax.barh(\n",
        "            ypos,\n",
        "            duration,\n",
        "            left=start,\n",
        "            height=1.0,\n",
        "            color=colour,\n",
        "            edgecolor=\"white\",\n",
        "            linewidth=1.0,\n",
        "            alpha=0.95,\n",
        "            zorder=3\n",
        "        )\n",
        "\n",
        "    tick_positions.append(ypos)\n",
        "    tick_labels.append(course[\"Course\"])\n",
        "\n",
        "# ============================================================\n",
        "# 8. COURSE LABELS\n",
        "# ============================================================\n",
        "\n",
        "ax.set_yticks(tick_positions)\n",
        "\n",
        "ax.set_yticklabels(\n",
        "    tick_labels,\n",
        "    fontsize=COURSE_FONT,\n",
        "    color=\"#263445\"\n",
        ")\n",
        "\n",
        "ax.tick_params(\n",
        "    axis=\"y\",\n",
        "    length=0,\n",
        "    pad=20\n",
        ")\n",
        "\n",
        "ax.tick_params(\n",
        "    axis=\"x\",\n",
        "    length=0,\n",
        "    pad=15,\n",
        "    labelsize=AXIS_FONT\n",
        ")\n",
        "\n",
        "# ============================================================\n",
        "# 9. MAIN TITLE\n",
        "# ============================================================\n",
        "\n",
        "fig.suptitle(\n",
        "    \"PhD courses and academic activities (30.5 ECTS) | 2025–2026\",\n",
        "    fontsize=TITLE_FONT,\n",
        "    fontweight=\"bold\",\n",
        "    color=\"#182C46\",\n",
        "    y=0.975\n",
        ")\n",
        "\n",
        "ax.set_xlabel(\n",
        "    \"Academic timeline\",\n",
        "    fontsize=28,\n",
        "    labelpad=25\n",
        ")\n",
        "\n",
        "for spine in ax.spines.values():\n",
        "    spine.set_visible(False)\n",
        "\n",
        "# ============================================================\n",
        "# 10. ECTS SUMMARY TABLE\n",
        "# ============================================================\n",
        "\n",
        "ax_table.axis(\"off\")\n",
        "\n",
        "summary = [\n",
        "    [\"Scientific courses\", \"10\"],\n",
        "    [\"GSNS onboarding programme\", \"4\"],\n",
        "    [\"Transferable skills\", \"7.5\"],\n",
        "    [\"Academic development / alternative ECTS\", \"9\"],\n",
        "    [\"TOTAL\", \"30.5\"]\n",
        "]\n",
        "\n",
        "table = ax_table.table(\n",
        "    cellText=summary,\n",
        "    colLabels=[\"PhD course category\", \"ECTS\"],\n",
        "    cellLoc=\"left\",\n",
        "    colLoc=\"left\",\n",
        "    colWidths=[0.8, 0.2],\n",
        "    bbox=[0.12, 0.04, 0.76, 0.92]\n",
        ")\n",
        "\n",
        "table.auto_set_font_size(False)\n",
        "table.set_fontsize(TABLE_FONT)\n",
        "\n",
        "for (r, c), cell in table.get_celld().items():\n",
        "\n",
        "    cell.set_edgecolor(\"#DDE4ED\")\n",
        "    cell.set_linewidth(1.0)\n",
        "\n",
        "    if r == 0:\n",
        "        cell.set_facecolor(\"#EAF0F7\")\n",
        "        cell.set_text_props(weight=\"bold\")\n",
        "\n",
        "    elif r == 5:\n",
        "        cell.set_facecolor(\"#DCE9F6\")\n",
        "        cell.set_text_props(weight=\"bold\")\n",
        "\n",
        "    elif r % 2 == 0:\n",
        "        cell.set_facecolor(\"#F7F9FC\")\n",
        "\n",
        "# ============================================================\n",
        "# 11. LAYOUT\n",
        "# ============================================================\n",
        "\n",
        "fig.subplots_adjust(\n",
        "    left=0.40,\n",
        "    right=0.96,\n",
        "    top=0.92,\n",
        "    bottom=0.06\n",
        ")\n",
        "\n",
        "# ============================================================\n",
        "# 12. SAVE CHART\n",
        "# ============================================================\n",
        "\n",
        "plt.savefig(\n",
        "    \"PhD_Gantt_30_5_ECTS.png\",\n",
        "    dpi=300,\n",
        "    bbox_inches=\"tight\",\n",
        "    facecolor=\"white\"\n",
        ")\n",
        "\n",
        "plt.savefig(\n",
        "    \"PhD_Gantt_30_5_ECTS.pdf\",\n",
        "    bbox_inches=\"tight\",\n",
        "    facecolor=\"white\"\n",
        ")\n",
        "\n",
        "plt.show()\n",
        "\n",
        "print(\"Gantt chart generated successfully.\")\n",
        "print(\"Total ECTS:\", sum(totals.values()))\n"
      ],
