        "\n",
        "# ============================================================\n",
        "# AZYKH CAVE — PAH DEPTH PROFILES + R² + MODERN SAMPLES\n",
        "#\n",
        "# (a) ΣPAHs (ng/g) — BLUE\n",
        "# (b) hPAHs (ng/g) — RED\n",
        "# (c) IPAHs (ng/g) — GREEN\n",
        "#\n",
        "# Roof and Exterior samples below the sediment profiles\n",
        "# Depth range: 0–1010 cm (depth scale hidden)\n",
        "# Thicker, clearer lines and sample markers\n",
        "# R² calculated using cave sediments only\n",
        "# Exports: 600 dpi PNG, PDF, SVG\n",
        "# ============================================================\n",
        "\n",
        "import pandas as pd\n",
        "import numpy as np\n",
        "import matplotlib.pyplot as plt\n",
        "from matplotlib.ticker import MaxNLocator\n",
        "from google.colab import files\n",
        "import re\n",
        "\n",
        "# ============================================================\n",
        "# 1. UPLOAD FILE\n",
        "# ============================================================\n",
        "\n",
        "print(\"Upload your PAHs data.csv file\")\n",
        "\n",
        "uploaded = files.upload()\n",
        "filename = next(iter(uploaded))\n",
        "\n",
        "if filename.lower().endswith(\".csv\"):\n",
        "    df = pd.read_csv(\n",
        "        filename,\n",
        "        sep=None,\n",
        "        engine=\"python\",\n",
        "        encoding=\"utf-8-sig\",\n",
        "        dtype=str\n",
        "    )\n",
        "else:\n",
        "    df = pd.read_excel(filename, dtype=str)\n",
        "\n",
        "df.columns = [\n",
        "    str(c).replace(\"\\ufeff\", \"\").strip()\n",
        "    for c in df.columns\n",
        "]\n",
        "\n",
        "print(\"\\nDetected columns:\")\n",
        "print(df.columns.tolist())\n",
        "\n",
        "# ============================================================\n",
        "# 2. AUTOMATICALLY IDENTIFY COLUMNS\n",
        "# ============================================================\n",
        "\n",
        "def normalize(name):\n",
        "    name = str(name).lower()\n",
        "    name = name.replace(\"Σ\", \"sum\").replace(\"∑\", \"sum\")\n",
        "    return re.sub(r\"[^a-z0-9]\", \"\", name)\n",
        "\n",
        "def find_column(aliases):\n",
        "    wanted = {normalize(a) for a in aliases}\n",
        "\n",
        "    for col in df.columns:\n",
        "        if normalize(col) in wanted:\n",
        "            return col\n",
        "\n",
        "    raise ValueError(\n",
        "        f\"Cannot find column matching {aliases}\\n\"\n",
        "        f\"Available columns: {df.columns.tolist()}\"\n",
        "    )\n",
        "\n",
        "depth_col = find_column([\n",
        "    \"Depth\",\n",
        "    \"Depth (cm)\"\n",
        "])\n",
        "\n",
        "total_col = find_column([\n",
        "    r\"[PAHs]\\(ng/g)\",\n",
        "    \"[PAHs](ng/g)\",\n",
        "    \"ΣPAHs (ng/g)\",\n",
        "    \"∑PAHs (ng/g)\",\n",
        "    \"Total PAHs (ng/g)\"\n",
        "])\n",
        "\n",
        "hpah_col = find_column([\n",
        "    \"hPAHs  (ng/g)\",\n",
        "    \"hPAHs (ng/g)\",\n",
        "    \"hPAHs\",\n",
        "    \"HMW PAHs (ng/g)\"\n",
        "])\n",
        "\n",
        "ipah_col = find_column([\n",
        "    \"IPAHs(ng/g)\",\n",
        "    \"IPAHs (ng/g)\",\n",
        "    \"IPAHs\"\n",
        "])\n",
        "\n",
        "print(\"\\nSelected columns:\")\n",
        "print(\"Depth:\", repr(depth_col))\n",
        "print(\"ΣPAHs:\", repr(total_col))\n",
        "print(\"hPAHs:\", repr(hpah_col))\n",
        "print(\"IPAHs:\", repr(ipah_col))\n",
        "\n",
        "# ============================================================\n",
        "# 3. CLEAN DATA\n",
        "# ============================================================\n",
        "\n",
        "for col in df.columns:\n",
        "    df[col] = (\n",
        "        df[col]\n",
        "        .fillna(\"\")\n",
        "        .astype(str)\n",
        "        .str.replace(\"\\u00a0\", \" \", regex=False)\n",
        "        .str.strip()\n",
        "    )\n",
        "\n",
        "def to_numeric(series):\n",
        "    return pd.to_numeric(\n",
        "        series.str.replace(\",\", \".\", regex=False),\n",
        "        errors=\"coerce\"\n",
        "    )\n",
        "\n",
        "for col in [total_col, hpah_col, ipah_col]:\n",
        "    df[col] = to_numeric(df[col])\n",
        "\n",
        "# ============================================================\n",
        "# 4. IDENTIFY ROOF AND EXTERIOR\n",
        "# ============================================================\n",
        "\n",
        "# Reference names can be in Depth or Sample column.\n",
        "\n",
        "depth_text = df[depth_col].str.lower()\n",
        "\n",
        "if \"Sample\" in df.columns:\n",
        "    sample_text = df[\"Sample\"].str.lower()\n",
        "else:\n",
        "    sample_text = pd.Series(\"\", index=df.index)\n",
        "\n",
        "roof_mask = (\n",
        "    depth_text.eq(\"roof\") |\n",
        "    sample_text.eq(\"roof\")\n",
        ")\n",
        "\n",
        "exterior_mask = (\n",
        "    depth_text.eq(\"exterior\") |\n",
        "    sample_text.eq(\"exterior\")\n",
        ")\n",
        "\n",
        "modern_mask = roof_mask | exterior_mask\n",
        "\n",
        "modern = df.loc[modern_mask].copy()\n",
        "\n",
        "modern[\"Category\"] = np.where(\n",
        "    roof_mask.loc[modern.index],\n",
        "    \"Roof\",\n",
        "    \"Exterior\"\n",
        ")\n",
        "\n",
        "# Sediment samples\n",
        "cave = df.loc[~modern_mask].copy()\n",
        "\n",
        "cave[\"Depth_numeric\"] = to_numeric(\n",
        "    cave[depth_col]\n",
        ")\n",
        "\n",
        "cave = cave[\n",
        "    cave[\"Depth_numeric\"].between(0, 1010)\n",
        "].sort_values(\"Depth_numeric\").copy()\n",
        "\n",
        "if cave.empty:\n",
        "    raise ValueError(\n",
        "        \"No valid sediment samples with depths 0–1010 cm found.\"\n",
        "    )\n",
        "\n",
        "print(\"\\nSample counts:\")\n",
        "print(\"Cave sediments:\", len(cave))\n",
        "print(\"Roof:\", (modern[\"Category\"] == \"Roof\").sum())\n",
        "print(\"Exterior:\", (modern[\"Category\"] == \"Exterior\").sum())\n",
        "\n",
        "if modern.empty:\n",
        "    print(\n",
        "        \"WARNING: No Roof or Exterior samples detected. \"\n",
        "        \"Check their names in the Depth or Sample column.\"\n",
        "    )\n",
        "\n",
        "# ============================================================\n",
        "# 5. FIGURE SETTINGS\n",
        "# ============================================================\n",
        "\n",
        "plt.rcParams.update({\n",
        "    \"font.family\": \"serif\",\n",
        "    \"font.serif\": [\"Times New Roman\", \"DejaVu Serif\"],\n",
        "    \"font.size\": 12,\n",
        "    \"axes.linewidth\": 0.8,\n",
        "    \"pdf.fonttype\": 42,\n",
        "    \"ps.fonttype\": 42,\n",
        "    \"svg.fonttype\": \"none\"\n",
        "})\n",
        "\n",
        "# ============================================================\n",
        "# 6. LINE AND MARKER SETTINGS\n",
        "# ============================================================\n",
        "\n",
        "# Adjust these values if needed.\n",
        "PROFILE_LINE_WIDTH = 1.4\n",
        "PROFILE_MARKER_SIZE = 3.5\n",
        "\n",
        "TREND_LINE_WIDTH = 1.3\n",
        "TREND_LINE_STYLE = \"--\"\n",
        "\n",
        "REFERENCE_MARKER_SIZE = 55\n",
        "\n",
        "# ============================================================\n",
        "# 7. FIGURE LAYOUT\n",
        "# ============================================================\n",
        "\n",
        "fig = plt.figure(figsize=(12, 12))\n",
        "\n",
        "gs = fig.add_gridspec(\n",
        "    2, 3,\n",
        "    height_ratios=[8, 0.9],\n",
        "    hspace=0.045,\n",
        "    wspace=0.12\n",
        ")\n",
        "\n",
        "colors = {\n",
        "    \"Total\": \"#2166AC\",\n",
        "    \"hPAH\": \"#D73027\",\n",
        "    \"IPAH\": \"#1A9850\"\n",
        "}\n",
        "\n",
        "panels = [\n",
        "    (\n",
        "        total_col,\n",
        "        \"(a) ΣPAHs (ng/g)\",\n",
        "        colors[\"Total\"]\n",
        "    ),\n",
        "    (\n",
        "        hpah_col,\n",
        "        \"(b) hPAHs (ng/g)\",\n",
        "        colors[\"hPAH\"]\n",
        "    ),\n",
        "    (\n",
        "        ipah_col,\n",
        "        \"(c) IPAHs (ng/g)\",\n",
        "        colors[\"IPAH\"]\n",
        "    )\n",
        "]\n",
        "\n",
        "modern_colors = {\n",
        "    \"Roof\": \"#E3A11A\",\n",
        "    \"Exterior\": \"#239CA7\"\n",
        "}\n",
        "\n",
        "modern_markers = {\n",
        "    \"Roof\": \"o\",\n",
        "    \"Exterior\": \"s\"\n",
        "}\n",
        "\n",
        "# ============================================================\n",
        "# 8. CREATE THREE PAH PANELS\n",
        "# ============================================================\n",
        "\n",
        "axes = []\n",
        "modern_axes = []\n",
        "results = []\n",
        "\n",
        "for i, (column, title, color) in enumerate(panels):\n",
        "\n",
        "    if i == 0:\n",
        "        ax = fig.add_subplot(gs[0, i])\n",
        "    else:\n",
        "        ax = fig.add_subplot(\n",
        "            gs[0, i],\n",
        "            sharey=axes[0]\n",
        "        )\n",
        "\n",
        "    ax_mod = fig.add_subplot(\n",
        "        gs[1, i],\n",
        "        sharex=ax\n",
        "    )\n",
        "\n",
        "    # --------------------------------------------------------\n",
        "    # 9. SEDIMENT PAH PROFILE\n",
        "    # --------------------------------------------------------\n",
        "\n",
        "    data = cave[\n",
        "        [\"Depth_numeric\", column]\n",
        "    ].replace(\n",
        "        [np.inf, -np.inf],\n",
        "        np.nan\n",
        "    ).dropna().sort_values(\"Depth_numeric\")\n",
        "\n",
        "    depth = data[\"Depth_numeric\"].to_numpy(dtype=float)\n",
        "    concentration = data[column].to_numpy(dtype=float)\n",
        "\n",
        "    # Thicker colored PAH profile\n",
        "    ax.plot(\n",
        "        concentration,\n",
        "        depth,\n",
        "        color=color,\n",
        "        linewidth=PROFILE_LINE_WIDTH,\n",
        "        marker=\"o\",\n",
        "        markersize=PROFILE_MARKER_SIZE,\n",
        "        markerfacecolor=color,\n",
        "        markeredgecolor=color,\n",
        "        markeredgewidth=0,\n",
        "        alpha=1.0,\n",
        "        zorder=3\n",
        "    )\n",
        "\n",
        "    # --------------------------------------------------------\n",
        "    # 10. LINEAR TREND AND R²\n",
        "    # --------------------------------------------------------\n",
        "\n",
        "    if (\n",
        "        len(depth) >= 3\n",
        "        and np.std(depth) > 0\n",
        "        and np.std(concentration) > 0\n",
        "    ):\n",
        "\n",
        "        slope, intercept = np.polyfit(\n",
        "            depth,\n",
        "            concentration,\n",
        "            1\n",
        "        )\n",
        "\n",
        "        predicted = (\n",
        "            slope * depth + intercept\n",
        "        )\n",
        "\n",
        "        ss_res = np.sum(\n",
        "            (concentration - predicted) ** 2\n",
        "        )\n",
        "\n",
        "        ss_tot = np.sum(\n",
        "            (concentration - concentration.mean()) ** 2\n",
        "        )\n",
        "\n",
        "        r2 = 1 - ss_res / ss_tot\n",
        "\n",
        "        # Smooth straight trend line\n",
        "        trend_depth = np.linspace(\n",
        "            depth.min(),\n",
        "            depth.max(),\n",
        "            400\n",
        "        )\n",
        "\n",
        "        trend_concentration = (\n",
        "            slope * trend_depth + intercept\n",
        "        )\n",
        "\n",
        "        # More visible black dashed trend line\n",
        "        ax.plot(\n",
        "            trend_concentration,\n",
        "            trend_depth,\n",
        "            color=\"black\",\n",
        "            linewidth=TREND_LINE_WIDTH,\n",
        "            linestyle=TREND_LINE_STYLE,\n",
        "            alpha=1.0,\n",
        "            zorder=4\n",
        "        )\n",
        "\n",
        "        r2_label = f\"R² = {r2:.3f}\"\n",
        "\n",
        "    else:\n",
        "        r2 = np.nan\n",
        "        r2_label = \"R² = N/A\"\n",
        "\n",
        "    results.append({\n",
        "        \"Proxy\": title,\n",
        "        \"N\": len(concentration),\n",
        "        \"R²\": r2\n",
        "    })\n",
        "\n",
        "    # --------------------------------------------------------\n",
        "    # 11. ROOF AND EXTERIOR BELOW THE SEDIMENT PROFILE\n",
        "    # --------------------------------------------------------\n",
        "\n",
        "    for row, category in enumerate([\n",
        "        \"Roof\",\n",
        "        \"Exterior\"\n",
        "    ]):\n",
        "\n",
        "        values = modern.loc[\n",
        "            modern[\"Category\"] == category,\n",
        "            column\n",
        "        ].replace(\n",
        "            [np.inf, -np.inf],\n",
        "            np.nan\n",
        "        ).dropna().to_numpy(dtype=float)\n",
        "\n",
        "        if len(values) == 0:\n",
        "            continue\n",
        "\n",
        "        # Slight vertical offsets to show separate samples\n",
        "        if len(values) > 1:\n",
        "            offsets = np.linspace(\n",
        "                -0.10,\n",
        "                0.10,\n",
        "                len(values)\n",
        "            )\n",
        "        else:\n",
        "            offsets = np.array([0.0])\n",
        "\n",
        "        ax_mod.scatter(\n",
        "            values,\n",
        "            np.full(len(values), row) + offsets,\n",
        "            color=modern_colors[category],\n",
        "            marker=modern_markers[category],\n",
        "            s=REFERENCE_MARKER_SIZE,\n",
        "            edgecolors=\"white\",\n",
        "            linewidths=0.5,\n",
        "            zorder=5\n",
        "        )\n",
        "\n",
        "    # Reference sample rows\n",
        "    ax_mod.set_ylim(1.45, -0.45)\n",
        "    ax_mod.set_yticks([0, 1])\n",
        "\n",
        "    if i == 0:\n",
        "        ax_mod.set_yticklabels(\n",
        "            [\"Roof\", \"Exterior\"],\n",
        "            fontsize=11\n",
        "        )\n",
        "    else:\n",
        "        ax_mod.set_yticklabels([])\n",
        "\n",
        "    ax_mod.tick_params(\n",
        "        axis=\"y\",\n",
        "        length=0,\n",
        "        pad=5\n",
        "    )\n",
        "\n",
        "    ax_mod.tick_params(\n",
        "        axis=\"x\",\n",
        "        bottom=False,\n",
        "        top=False,\n",
        "        labelbottom=False,\n",
        "        labeltop=False\n",
        "    )\n",
        "\n",
        "    # Subtle reference guides\n",
        "    for row in [0, 1]:\n",
        "        ax_mod.axhline(\n",
        "            row,\n",
        "            color=\"gray\",\n",
        "            linewidth=0.5,\n",
        "            alpha=0.25\n",
        "        )\n",
        "\n",
        "    # --------------------------------------------------------\n",
        "    # 12. CONCENTRATION SCALE\n",
        "    # --------------------------------------------------------\n",
        "\n",
        "    # Same x-axis scale for sediment and modern samples\n",
        "    all_values = pd.concat([\n",
        "        cave[column],\n",
        "        modern[column]\n",
        "    ]).replace(\n",
        "        [np.inf, -np.inf],\n",
        "        np.nan\n",
        "    ).dropna()\n",
        "\n",
        "    if len(all_values) > 0:\n",
        "\n",
        "        xmin = min(\n",
        "            0,\n",
        "            all_values.min()\n",
        "        )\n",
        "\n",
        "        xmax = all_values.max()\n",
        "\n",
        "        padding = max(\n",
        "            (xmax - xmin) * 0.06,\n",
        "            0.01\n",
        "        )\n",
        "\n",
        "        ax.set_xlim(\n",
        "            xmin - padding,\n",
        "            xmax + padding\n",
        "        )\n",
        "\n",
        "    # --------------------------------------------------------\n",
        "    # 13. PANEL TITLE AND R²\n",
        "    # --------------------------------------------------------\n",
        "\n",
        "    # Depth increases downward\n",
        "    ax.set_ylim(1010, 0)\n",
        "\n",
        "    # Concentration scale at top\n",
        "    ax.xaxis.tick_top()\n",
        "    ax.xaxis.set_label_position(\"top\")\n",
        "\n",
        "    ax.set_xlabel(\n",
        "        title,\n",
        "        fontsize=14,\n",
        "        fontweight=\"bold\",\n",
        "        labelpad=7\n",
        "    )\n",
        "\n",
        "    ax.xaxis.set_major_locator(\n",
        "        MaxNLocator(nbins=4)\n",
        "    )\n",
        "\n",
        "    ax.tick_params(\n",
        "        axis=\"x\",\n",
        "        top=True,\n",
        "        bottom=False,\n",
        "        labeltop=True,\n",
        "        labelbottom=False,\n",
        "        direction=\"out\",\n",
        "        length=3,\n",
        "        width=0.8,\n",
        "        labelsize=11,\n",
        "        pad=3\n",
        "    )\n",
        "\n",
        "    # R² label\n",
        "    ax.text(\n",
        "        0.97,\n",
        "        0.045,\n",
        "        r2_label,\n",
        "        transform=ax.transAxes,\n",
        "        fontsize=11,\n",
        "        fontweight=\"bold\",\n",
        "        ha=\"right\",\n",
        "        va=\"top\",\n",
        "        color=\"black\"\n",
        "    )\n",
        "\n",
        "    # Hide depth scale\n",
        "    ax.tick_params(\n",
        "        axis=\"y\",\n",
        "        left=False,\n",
        "        right=False,\n",
        "        labelleft=False,\n",
        "        labelright=False\n",
        "    )\n",
        "\n",
        "    ax.set_ylabel(\"\")\n",
        "\n",
        "    # Remove unnecessary borders\n",
        "    ax.spines[\"right\"].set_visible(False)\n",
        "    ax.spines[\"bottom\"].set_visible(False)\n",
        "    ax.spines[\"left\"].set_visible(False)\n",
        "    ax.spines[\"top\"].set_linewidth(0.8)\n",
        "\n",
        "    for spine in ax_mod.spines.values():\n",
        "        spine.set_visible(False)\n",
        "\n",
        "    ax.grid(False)\n",
        "    ax_mod.grid(False)\n",
        "\n",
        "    axes.append(ax)\n",
        "    modern_axes.append(ax_mod)\n",
        "\n",
        "# ============================================================\n",
        "# 14. FINAL LAYOUT\n",
        "# ============================================================\n",
        "\n",
        "fig.subplots_adjust(\n",
        "    left=0.10,\n",
        "    right=0.99,\n",
        "    top=0.91,\n",
        "    bottom=0.055,\n",
        "    wspace=0.12,\n",
        "    hspace=0.045\n",
        ")\n",
        "\n",
        "# ============================================================\n",
        "# 15. SAVE FIGURES\n",
        "# ============================================================\n",
        "\n",
        "png_file = \"Azykh_PAH_Profiles_R2_Visible.png\"\n",
        "pdf_file = \"Azykh_PAH_Profiles_R2_Visible.pdf\"\n",
        "svg_file = \"Azykh_PAH_Profiles_R2_Visible.svg\"\n",
        "\n",
        "fig.savefig(\n",
        "    png_file,\n",
        "    dpi=600,\n",
        "    bbox_inches=\"tight\",\n",
        "    facecolor=\"white\"\n",
        ")\n",
        "\n",
        "fig.savefig(\n",
        "    pdf_file,\n",
        "    bbox_inches=\"tight\",\n",
        "    facecolor=\"white\"\n",
        ")\n",
        "\n",
        "fig.savefig(\n",
        "    svg_file,\n",
        "    bbox_inches=\"tight\",\n",
        "    facecolor=\"white\"\n",
        ")\n",
        "\n",
        "plt.show()\n",
        "\n",
        "# ============================================================\n",
        "# 16. DISPLAY R² VALUES\n",
        "# ============================================================\n",
        "\n",
        "results_df = pd.DataFrame(results)\n",
        "\n",
        "print(\"\\nPAH LINEAR REGRESSION RESULTS\")\n",
        "print(results_df.to_string(index=False))\n",
        "\n",
        "# ============================================================\n",
        "# 17. DOWNLOAD FILES\n",
        "# ============================================================\n",
        "\n",
        "files.download(png_file)\n",
        "files.download(pdf_file)\n",
        "files.download(svg_file)\n",
        "\n",
        "print(\"\\nPAH figure completed successfully.\")\n"
      ]
    }
  ]
}